---
import { Picture } from 'astro:assets';
import 'lite-youtube-embed/src/lite-yt-embed.css';
import { videos, socials, upcoming } from '../data/site';
import Icon from './Icon.astro';

const youtube = socials.find((s) => s.icon === 'youtube');
---

<section id="videos" aria-labelledby="videos-title" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="section-kicker">02 // Videos</p>
        <h2 id="videos-title" class="mt-3 text-5xl font-extrabold tracking-tight sm:text-7xl">Lights. Camera. LOP3Z.</h2>
      </div>
      {
        youtube && (
          <a href={youtube.url} target="_blank" rel="noopener" class="btn btn-ghost !min-h-11 !px-4 !text-xs">
            <Icon name="youtube" class="size-4" />
            Subscribe on YouTube
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        )
      }
    </div>

    <div class="reveal mt-12 grid gap-6 lg:grid-cols-[1fr_17rem]">
      <!-- Screen -->
      <div class="card p-2.5 sm:p-3" id="video-screen">
        {
          videos.map((video, i) => (
            <div id={`video-panel-${i}`} role="tabpanel" aria-labelledby={`video-tab-${i}`} hidden={i !== 0} data-panel>
              <lite-youtube
                videoid={video.youtubeId}
                title={`${video.title} — LOP3Z (official video)`}
                params="rel=0&modestbranding=1"
                style="background-image: linear-gradient(#0b0e16, #0b0e16)"
                class="overflow-hidden"
              >
                <Picture
                  src={video.poster}
                  formats={['webp']}
                  widths={[96]}
                  sizes="96px"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'yt-poster yt-poster-fill', 'aria-hidden': 'true' }}
                />
                <Picture
                  src={video.poster}
                  formats={['avif', 'webp']}
                  widths={[360, 540, 800]}
                  sizes="(min-width: 1024px) 60vw, 90vw"
                  alt={`${video.posterAlt} — video poster`}
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'yt-poster yt-poster-main' }}
                />
                <button type="button" class="lyt-playbtn">
                  <span class="lyt-visually-hidden">Play video: {video.title} by LOP3Z</span>
                </button>
              </lite-youtube>
              <div class="flex items-center justify-between gap-3 px-1 pt-3 pb-1">
                <h3 class="text-xl font-bold sm:text-2xl">{video.title} <span class="font-mono text-xs font-normal text-muted">Official video</span></h3>
                <a
                  href={video.url}
                  target="_blank"
                  rel="noopener"
                  class="label text-[0.68rem] text-muted transition-colors hover:text-amber"
                >
                  YouTube ↗<span class="sr-only"> — watch {video.title} on YouTube (opens in a new tab)</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>

      <!-- Channel list -->
      <div>
        <div role="tablist" aria-label="Choose a video" aria-orientation="vertical" class="grid gap-2 sm:grid-cols-3 lg:grid-cols-1">
          {
            videos.map((video, i) => (
              <button
                type="button"
                role="tab"
                id={`video-tab-${i}`}
                aria-controls={`video-panel-${i}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                class="video-tab"
              >
                <span class="font-mono text-xs text-cyan">{String(i + 1).padStart(2, '0')}</span>
                <span class="flex-1 text-left text-lg font-bold">{video.title}</span>
                <span class="video-tab-live label text-[0.6rem]" aria-hidden="true">On screen</span>
              </button>
            ))
          }
          <div class="video-tab pointer-events-none !border-dashed opacity-80" aria-hidden="true">
            <span class="font-mono text-xs text-gold">{String(videos.length + 1).padStart(2, '0')}</span>
            <span class="flex-1 text-left text-lg font-bold">{upcoming.title}</span>
            <span class="label text-[0.6rem] text-gold">Soon</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import 'lite-youtube-embed';

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#videos [role=tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('#videos [data-panel]')];
  // Keep pristine copies so switching away from a playing video stops it.
  const pristine = panels.map((p) => p.querySelector('lite-youtube')!.cloneNode(true) as HTMLElement);

  const select = (i: number, focus = false) => {
    tabs.forEach((t, j) => {
      const on = i === j;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = panels[j];
      if (!on && !panel.hidden) {
        panel.querySelector('lite-youtube')?.replaceWith(pristine[j].cloneNode(true));
      }
      panel.hidden = !on;
    });
    if (focus) tabs[i].focus();
  };

  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(i));
    t.addEventListener('keydown', (e) => {
      const next = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }[e.key];
      if (next === undefined) return;
      e.preventDefault();
      select((i + next + tabs.length) % tabs.length, true);
    });
  });
</script>
