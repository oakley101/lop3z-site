---
import { Picture } from 'astro:assets';
import 'lite-youtube-embed/src/lite-yt-embed.css';
import { videos, socials } from '../data/site';
import Icon from './Icon.astro';

const youtube = socials.find((s) => s.icon === 'youtube');

// The first video is the big one; the rest stack in a column beside it.
// Full class names so Tailwind picks them up.
const stacked = {
  2: { grid: 'lg:grid-rows-2', feature: 'lg:row-span-2' },
  3: { grid: 'lg:grid-rows-3', feature: 'lg:row-span-3' },
  4: { grid: 'lg:grid-rows-4', feature: 'lg:row-span-4' },
}[Math.min(Math.max(videos.length - 1, 2), 4) as 2 | 3 | 4];
---

<section id="videos" aria-labelledby="videos-title" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="section-kicker">02 // Videos</p>
        <h2 id="videos-title" class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">Watch</h2>
      </div>
      {
        youtube && (
          <a href={youtube.url} target="_blank" rel="noopener" class="btn btn-ghost !min-h-11 !px-4 !text-xs">
            <Icon name="youtube" class="size-4" />
            Subscribe on YouTube
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        )
      }
    </div>

    <ul class:list={['mt-12 grid gap-6 lg:grid-cols-3', stacked.grid]}>
      {
        videos.map((video, i) => (
          <li
            class:list={['reveal', i === 0 && ['lg:col-span-2', stacked.feature]]}
            style={`transition-delay:${i * 100}ms`}
          >
            <article class="card group flex h-full flex-col p-2.5 sm:p-3">
              <lite-youtube
                videoid={video.youtubeId}
                title={`${video.title} — LOP3Z (official video)`}
                params="rel=0&modestbranding=1"
                style="background-image: linear-gradient(#0b0e16, #0b0e16)"
                class:list={['overflow-hidden', i === 0 && 'lg:flex-1']}
              >
                <Picture
                  src={video.poster}
                  formats={['webp']}
                  widths={[96]}
                  sizes="96px"
                  alt=""
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'yt-poster yt-poster-fill', 'aria-hidden': 'true' }}
                />
                <Picture
                  src={video.poster}
                  formats={['avif', 'webp']}
                  widths={[360, 540, 800]}
                  sizes={i === 0 ? '(min-width: 1024px) 50vw, 90vw' : '(min-width: 1024px) 25vw, 90vw'}
                  alt={`${video.posterAlt} — video poster`}
                  loading="lazy"
                  decoding="async"
                  pictureAttributes={{ class: 'yt-poster yt-poster-main' }}
                />
                <button type="button" class="lyt-playbtn">
                  <span class="lyt-visually-hidden">Play video: {video.title} by LOP3Z</span>
                </button>
              </lite-youtube>
              <div class="flex items-center justify-between gap-3 px-1 pt-3 pb-1">
                <h3 class="flex items-center gap-3 text-lg font-bold sm:text-xl">
                  <span class="font-mono text-xs text-cyan">{String(i + 1).padStart(2, '0')}</span>
                  {video.title}
                </h3>
                <a
                  href={video.url}
                  target="_blank"
                  rel="noopener"
                  class="label text-[0.68rem] text-muted transition-colors hover:text-amber"
                >
                  YouTube ↗<span class="sr-only"> — watch {video.title} on YouTube (opens in a new tab)</span>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import 'lite-youtube-embed';
</script>
