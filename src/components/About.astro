---
import { Picture } from 'astro:assets';
import portrait from '../assets/images/about-portrait.jpg';
import { artist, contact, socials, upcoming } from '../data/site';
import Equalizer from './Equalizer.astro';
import Icon from './Icon.astro';

const instagram = socials.find((s) => s.icon === 'instagram');
---

<section id="about" aria-labelledby="about-title" class="relative py-24 sm:py-32">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:gap-20 lg:px-8">
    <div class="reveal relative mx-auto w-full max-w-md md:max-w-none">
      <!-- Offset accent frame -->
      <div class="absolute -inset-3 translate-x-4 translate-y-4 border border-amber/50 sm:-inset-4" aria-hidden="true"></div>
      <div class="relative aspect-[4/5] overflow-hidden bg-ink-2">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          widths={[400, 640, 886]}
          sizes="(min-width: 768px) 45vw, 90vw"
          alt="Portrait of LOP3Z in an ivory double-breasted suit and blue-lens sunglasses, twisted locs framing her face, silver rings on both hands."
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover object-top"
          pictureAttributes={{ class: 'block h-full w-full' }}
        />
      </div>
      <div class="absolute bottom-4 left-4 flex items-center gap-3 bg-ink/80 px-3 py-2 backdrop-blur-sm">
        <Equalizer bars={5} height="14px" />
        <span class="font-mono text-xs tracking-[0.15em] text-fg uppercase">“{upcoming.title}” · <span data-before-release>23.10.26</span><span data-after-release>Out now</span></span>
      </div>
    </div>

    <div class="reveal">
      <p class="section-kicker">03 // About</p>
      <h2 id="about-title" class="mt-3 text-5xl font-extrabold tracking-tight sm:text-7xl">
        Vibez by <span class="name-gradient">LOP3Z.</span>
      </h2>
      <div class="mt-8 space-y-5 text-lg leading-relaxed text-muted sm:text-xl">
        {artist.bio.map((p, i) => <p class:list={[i === 0 && 'text-fg']}>{p}</p>)}
      </div>
      <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-line pt-8">
        <div>
          <dt class="label text-[0.68rem] text-muted">Sound</dt>
          <dd class="mt-1 font-mono text-sm text-fg">{artist.genre} / Rap</dd>
        </div>
        <div>
          <dt class="label text-[0.68rem] text-muted">Next drop</dt>
          <dd class="mt-1 font-mono text-sm text-gold">{upcoming.title}</dd>
        </div>
        <div>
          <dt class="label text-[0.68rem] text-muted">Team</dt>
          <dd class="mt-1 font-mono text-sm text-fg">{contact.management}</dd>
        </div>
      </dl>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={artist.spotifyArtist} target="_blank" rel="noopener" class="btn btn-primary">
          <Icon name="spotify" class="size-4" />
          Follow on Spotify<span class="sr-only"> (opens in a new tab)</span>
        </a>
        {
          instagram && (
            <a href={instagram.url} target="_blank" rel="noopener" class="btn btn-ghost">
              <Icon name="instagram" class="size-4" />
              {artist.handle}
              <span class="sr-only">on Instagram (opens in a new tab)</span>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
