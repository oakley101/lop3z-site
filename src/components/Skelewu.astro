---
import { Picture } from 'astro:assets';
import { artist, upcoming } from '../data/site';
import Countdown from './Countdown.astro';
import Equalizer from './Equalizer.astro';
import Icon from './Icon.astro';
import Share from './Share.astro';

const day = upcoming.releaseAt.slice(0, 10).replaceAll('-', '');
const googleCal =
  'https://calendar.google.com/calendar/render?action=TEMPLATE' +
  `&text=${encodeURIComponent(`${artist.name} – “${upcoming.title}” out now`)}` +
  `&dates=${day}/${day}` +
  `&details=${encodeURIComponent(`New single from ${artist.name}. ${new URL('/#skelewu', Astro.site).href}`)}`;
const streamUrl = upcoming.spotify || artist.spotifyArtist;
---

<section id="skelewu" aria-labelledby="skelewu-title" class="skelewu relative isolate overflow-hidden py-24 sm:py-32">
  <!-- Warm party glow pulled from the cover art -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute top-1/2 left-[20%] size-[46rem] -translate-1/2 rounded-full bg-[radial-gradient(circle,rgb(255_196_61/0.22),transparent_62%)]"></div>
    <div class="absolute right-[-10%] bottom-[-20%] size-[40rem] rounded-full bg-[radial-gradient(circle,rgb(64_196_120/0.16),transparent_62%)]"></div>
  </div>

  <div class="mx-auto grid max-w-7xl items-center gap-14 px-4 sm:px-6 lg:grid-cols-[5fr_6fr] lg:gap-20 lg:px-8">
    <!-- Cover -->
    <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none">
      <div class="cover-tilt relative aspect-square">
        <div class="absolute -inset-6 -z-10 rounded-[2rem] bg-[conic-gradient(from_180deg,#ffc43d,#3fc478,#22e4ff,#ff6b7a,#ffc43d)] opacity-40 blur-3xl" aria-hidden="true"></div>
        <Picture
          src={upcoming.cover}
          formats={['avif', 'webp']}
          widths={[400, 640, 900]}
          sizes="(min-width: 1024px) 40vw, 90vw"
          alt={upcoming.coverAlt}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover shadow-[0_30px_80px_-20px_rgb(0_0_0/0.8)]"
          pictureAttributes={{ class: 'block h-full w-full overflow-hidden ring-1 ring-white/10' }}
        />
        <!-- Date sticker -->
        <div
          class="absolute -right-3 -bottom-6 grid size-24 -rotate-12 place-items-center rounded-full bg-gold text-center text-ink shadow-xl sm:-right-6 sm:size-28"
          aria-hidden="true"
        >
          <span class="leading-none">
            <span class="block font-display text-2xl font-extrabold sm:text-3xl" data-before-release>23.10</span>
            <span class="block font-display text-xl font-extrabold sm:text-2xl" data-after-release>OUT</span>
            <span class="label block text-[0.6rem] tracking-[0.2em]" data-before-release>2026</span>
            <span class="label block text-[0.6rem] tracking-[0.2em]" data-after-release>NOW</span>
          </span>
        </div>
      </div>
    </div>

    <!-- Copy + actions -->
    <div class="reveal">
      <p class="section-kicker !text-gold flex items-center gap-3">
        <span class="inline-block size-2 rounded-full bg-gold animate-pulse-dot [--tw-shadow-color:theme(--color-gold)]" aria-hidden="true"></span>
        <span data-before-release>New single · Coming soon</span>
        <span data-after-release>New single · Out now</span>
      </p>
      <h2 id="skelewu-title" class="mt-4 font-display text-[clamp(3.6rem,13vw,8.5rem)] leading-[0.85] font-extrabold tracking-[-0.03em]">
        <span class="gold-gradient">{upcoming.title}</span>
      </h2>
      <p class="mt-5 max-w-lg text-lg text-muted sm:text-xl">
        <span data-before-release>The next one from {artist.name} lands everywhere on <span class="text-fg">{upcoming.releaseLabel}</span>. Turn it up.</span>
        <span data-after-release>The new one from {artist.name} is out everywhere now. Turn it up.</span>
      </p>

      <Countdown class="mt-9 max-w-lg" />

      <!-- Primary actions -->
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={streamUrl} target="_blank" rel="noopener" class="btn btn-gold" data-after-release>
          <Equalizer bars={4} height="14px" class="[--color-cyan:var(--color-ink)] [--color-amber:var(--color-ink)]" />
          Stream “{upcoming.title}”<span class="sr-only"> (opens in a new tab)</span>
        </a>
        {
          upcoming.presave ? (
            <a href={upcoming.presave} target="_blank" rel="noopener" class="btn btn-gold" data-before-release>
              Pre-save<span class="sr-only"> “{upcoming.title}” (opens in a new tab)</span>
            </a>
          ) : (
            <a href={artist.spotifyArtist} target="_blank" rel="noopener" class="btn btn-gold" data-before-release>
              <Icon name="spotify" class="size-4" />
              Follow on Spotify<span class="sr-only"> to get it on release day (opens in a new tab)</span>
            </a>
          )
        }
        <details class="cal relative" data-before-release>
          <summary class="btn btn-ghost cursor-pointer list-none">
            <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="5" width="18" height="16" rx="1"></rect><path d="M3 10h18M8 3v4M16 3v4"></path>
            </svg>
            Add to calendar
          </summary>
          <ul class="absolute left-0 z-10 mt-2 w-56 border border-line bg-panel p-1.5 shadow-2xl">
            <li><a href={googleCal} target="_blank" rel="noopener" class="cal-item">Google Calendar<span class="sr-only"> (opens in a new tab)</span></a></li>
            <li><a href="/skelewu.ics" download="lop3z-skelewu.ics" class="cal-item">Apple / Outlook (.ics)</a></li>
          </ul>
        </details>
      </div>

      <!-- Release-day alert (Netlify Forms) -->
      <form
        id="notify-form"
        name="release-alerts"
        method="POST"
        action="/thanks/?form=alerts"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-10 max-w-lg border-t border-line pt-8"
        data-before-release
      >
        <input type="hidden" name="form-name" value="release-alerts" />
        <input type="hidden" name="release" value={upcoming.title} />
        <p class="hidden" aria-hidden="true">
          <label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <label for="nf-email" class="label block text-[0.7rem] text-fg">Get a heads-up on release day</label>
        <div class="mt-3 flex flex-col gap-2 sm:flex-row">
          <input
            id="nf-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="your@email.com"
            class="field flex-1"
            aria-describedby="nf-status"
          />
          <button type="submit" class="btn btn-ghost shrink-0" data-submit>Notify me</button>
        </div>
        <p id="nf-status" role="status" aria-live="polite" class="mt-2 min-h-5 text-sm text-muted">One email when it drops. No spam.</p>
      </form>

      <div class="mt-8">
        <p class="label mb-3 text-[0.68rem] text-muted">Spread the word</p>
        <Share text={`New ${artist.name} single “${upcoming.title}” drops ${upcoming.releaseLabel.replace(/^\w+ /, '')} 🔥`} hash="#skelewu" />
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('notify-form') as HTMLFormElement | null;
  const status = document.getElementById('nf-status');
  const btn = form?.querySelector<HTMLButtonElement>('[data-submit]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.querySelector<HTMLInputElement>('input[type=email]')!;
    if (!email.checkValidity()) {
      email.setAttribute('aria-invalid', 'true');
      if (status) status.textContent = 'Please enter a valid email address.';
      email.focus();
      return;
    }
    email.removeAttribute('aria-invalid');
    if (btn) btn.disabled = true;
    try {
      const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>).toString();
      const res = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body,
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      form.reset();
      if (status) {
        status.textContent = 'You’re on the list. See you on release day.';
        status.className = 'mt-2 min-h-5 text-sm text-ok';
      }
    } catch {
      if (status) {
        status.textContent = 'Couldn’t sign you up just now. Please try again.';
        status.className = 'mt-2 min-h-5 text-sm text-danger';
      }
    } finally {
      if (btn) btn.disabled = false;
    }
  });

  // Close the calendar menu when clicking elsewhere.
  document.addEventListener('click', (e) => {
    document.querySelectorAll<HTMLDetailsElement>('details.cal[open]').forEach((d) => {
      if (!d.contains(e.target as Node)) d.open = false;
    });
  });
</script>
