---
// Share buttons: native share sheet (where supported), WhatsApp, X, Facebook, copy link.
// Links are built from the canonical site URL and re-pointed at the current origin in
// the browser, so they also work on preview deploys.
import Icon from './Icon.astro';

interface Props {
  text: string;
  hash?: string;
  class?: string;
}
const { text, hash = '', class: className = '' } = Astro.props;
const url = new URL(`/${hash}`, Astro.site).href;
const enc = encodeURIComponent;

const links = [
  { key: 'whatsapp', label: 'WhatsApp', href: `https://wa.me/?text=${enc(`${text} ${url}`)}` },
  { key: 'x', label: 'X', href: `https://x.com/intent/post?text=${enc(text)}&url=${enc(url)}` },
  { key: 'facebook', label: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}` },
];
---

<div class:list={['share flex flex-wrap items-center gap-2', className]} data-share data-text={text} data-hash={hash}>
  <button type="button" class="share-btn hidden" data-native>
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v14"></path>
    </svg>
    Share
  </button>
  {
    links.map((l) => (
      <a href={l.href} target="_blank" rel="noopener" class="share-btn" data-kind={l.key}>
        {l.key === 'x' ? (
          <Icon name="x" class="size-3.5" />
        ) : l.key === 'whatsapp' ? (
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3Z" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
            <path d="M14 8V6c0-.9.6-1 1-1h3V1h-4c-4 0-5 3-5 5v2H6v4h3v11h5V12h3.5l.5-4h-4Z" />
          </svg>
        )}
        {l.label}
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    ))
  }
  <button type="button" class="share-btn" data-copy>
    <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path>
    </svg>
    <span data-copy-label>Copy link</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-share]').forEach((root) => {
    const text = root.dataset.text ?? '';
    const url = `${location.origin}/${root.dataset.hash ?? ''}`;
    const enc = encodeURIComponent;

    root.querySelectorAll<HTMLAnchorElement>('a[data-kind]').forEach((a) => {
      if (a.dataset.kind === 'whatsapp') a.href = `https://wa.me/?text=${enc(`${text} ${url}`)}`;
      if (a.dataset.kind === 'x') a.href = `https://x.com/intent/post?text=${enc(text)}&url=${enc(url)}`;
      if (a.dataset.kind === 'facebook') a.href = `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`;
    });

    const native = root.querySelector<HTMLButtonElement>('[data-native]');
    if (native && 'share' in navigator) {
      native.classList.remove('hidden');
      native.addEventListener('click', () => navigator.share({ title: 'LOP3Z', text, url }).catch(() => {}));
    }

    const copy = root.querySelector<HTMLButtonElement>('[data-copy]');
    const label = root.querySelector<HTMLElement>('[data-copy-label]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        if (label) label.textContent = 'Link copied';
      } catch {
        if (label) label.textContent = url;
      }
      setTimeout(() => label && (label.textContent = 'Copy link'), 2500);
    });
  });
</script>
