---
import { Picture } from 'astro:assets';
import heroImg from '../assets/images/hero.jpg';
import { artist, upcoming } from '../data/site';
import Countdown from './Countdown.astro';
import Equalizer from './Equalizer.astro';
---

<section id="top" class="relative isolate flex min-h-[100svh] items-end overflow-hidden pt-24 pb-16 sm:pb-20 lg:items-center">
  <!-- Background portrait: full-bleed on mobile, right-anchored on large screens -->
  <div
    class="absolute inset-0 -z-10 lg:left-auto lg:w-[58%] lg:[mask-image:linear-gradient(to_right,transparent,black_40%)]"
  >
    <Picture
      src={heroImg}
      formats={['avif', 'webp']}
      widths={[480, 768, 1024]}
      sizes="(min-width: 1024px) 58vw, 100vw"
      alt="LOP3Z in blue-tinted sunglasses and silver rings, hands clasped under her chin, lit in cool blue light."
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-[50%_25%]"
      pictureAttributes={{ class: 'block h-full w-full' }}
    />
  </div>
  <!-- Dark gradient overlays for text legibility -->
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-ink via-ink/70 to-ink/20 lg:bg-gradient-to-r lg:from-ink lg:from-40% lg:via-ink/70 lg:via-60% lg:to-ink/10"
    aria-hidden="true"
  >
  </div>
  <div class="absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-ink to-transparent" aria-hidden="true"></div>

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <a
        href="#skelewu"
        class="group mb-6 inline-flex items-center gap-3 border border-gold/40 bg-ink/60 py-1.5 pr-4 pl-2 backdrop-blur-sm transition-colors hover:border-gold"
      >
        <span class="inline-block size-2 rounded-full bg-gold animate-pulse-dot" aria-hidden="true"></span>
        <span class="label text-[0.7rem] text-fg">
          <span data-before-release>New single 23.10</span><span data-after-release>New single out now</span>
        </span>
        <span class="font-mono text-xs text-gold">“{upcoming.title}”</span>
        <span aria-hidden="true" class="text-gold transition-transform group-hover:translate-x-1">→</span>
      </a>

      <h1 class="font-display text-[clamp(4.5rem,20vw,11rem)] leading-[0.85] font-extrabold tracking-[-0.02em]">
        <span class="name-gradient">{artist.name}</span>
      </h1>

      <p class="mt-5 flex flex-wrap items-center gap-x-3 font-mono text-sm tracking-[0.18em] text-fg uppercase sm:text-base">
        {
          artist.roles.map((role, i) => (
            <>
              {i > 0 && (
                <span class="text-cyan" aria-hidden="true">
                  //
                </span>
              )}
              <span>{role}</span>
            </>
          ))
        }
      </p>

      <p class="mt-5 max-w-md text-lg text-muted sm:text-xl">{artist.tagline}</p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a href={artist.spotifyArtist} target="_blank" rel="noopener" class="btn btn-primary">
          <Equalizer bars={4} height="14px" class="[--color-cyan:var(--color-ink)] [--color-amber:var(--color-ink)]" />
          Listen now
          <span class="sr-only">— LOP3Z on Spotify (opens in a new tab)</span>
        </a>
        <a href="#videos" class="btn btn-ghost">Watch videos</a>
      </div>

      <!-- Next-drop teaser -->
      <a
        href="#skelewu"
        class="group mt-10 flex max-w-sm items-center gap-4 border border-line bg-ink/70 p-2.5 pr-5 backdrop-blur-md transition-colors hover:border-gold/70"
      >
        <Picture
          src={upcoming.cover}
          formats={['avif', 'webp']}
          widths={[72, 144]}
          sizes="72px"
          alt=""
          loading="eager"
          class="size-[72px] object-cover"
          pictureAttributes={{ class: 'block size-[72px] shrink-0 overflow-hidden' }}
        />
        <span class="min-w-0 flex-1">
          <span class="label block text-[0.62rem] text-gold">
            <span data-before-release>Next drop</span><span data-after-release>Out now</span>
          </span>
          <span class="block text-xl font-extrabold">{upcoming.title}</span>
          <Countdown variant="compact" class="block text-xs text-muted" />
          <span class="block font-mono text-xs text-muted" data-after-release>Stream it everywhere</span>
        </span>
        <span aria-hidden="true" class="text-gold transition-transform group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>

  <a
    href="#skelewu"
    class="absolute bottom-6 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-muted transition-colors hover:text-cyan sm:flex"
  >
    <span class="label text-[0.65rem]">Scroll</span>
    <span class="block h-10 w-px bg-gradient-to-b from-cyan to-transparent" aria-hidden="true"></span>
  </a>
</section>
