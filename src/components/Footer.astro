---
import { artist, contact, socials, streaming, nav } from '../data/site';
import Equalizer from './Equalizer.astro';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
const profiles = [...streaming, ...socials];
---

<footer class="relative border-t border-line bg-ink-2/60">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-10 md:flex-row md:items-end md:justify-between">
      <div>
        <a href="#top" class="inline-flex items-center gap-3 text-4xl font-extrabold tracking-[0.08em] sm:text-5xl">
          <span class="name-gradient">{artist.name}</span>
          <span class="sr-only"> — back to top</span>
        </a>
        <p class="mt-3 flex items-center gap-3 font-mono text-xs tracking-[0.18em] text-muted uppercase">
          <Equalizer bars={5} height="12px" />
          {artist.roles.join(' // ')}
        </p>
      </div>

      <ul class="flex flex-wrap gap-2.5" aria-label="LOP3Z on streaming and social platforms">
        {
          profiles.map((p) => (
            <li>
              <a
                href={p.url}
                target="_blank"
                rel="noopener me"
                class="grid size-11 place-items-center border border-line text-muted transition-[color,border-color,translate] duration-200 hover:-translate-y-0.5 hover:border-cyan hover:text-cyan"
              >
                <Icon name={p.icon} class="size-[18px]" />
                <span class="sr-only">{p.label} (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 flex flex-col gap-6 border-t border-line pt-8 text-sm text-muted md:flex-row md:items-center md:justify-between">
      <p>
        © {year} {artist.name}. All rights reserved. · Management: {contact.management}
      </p>
      <nav aria-label="Footer">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="label text-[0.68rem] transition-colors hover:text-cyan">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
