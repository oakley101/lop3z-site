---
import { Picture } from 'astro:assets';
import { featured, singles, streaming } from '../data/site';
import Equalizer from './Equalizer.astro';
import Icon from './Icon.astro';
---

<section id="music" aria-labelledby="music-title" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="section-kicker">01 // Music</p>
        <h2 id="music-title" class="mt-3 text-4xl font-bold tracking-tight sm:text-6xl">Singles</h2>
      </div>
      <ul class="flex flex-wrap gap-3" aria-label="Follow LOP3Z on streaming platforms">
        {
          streaming.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" class="btn btn-ghost !min-h-11 !px-4 !text-xs">
                <Icon name={s.icon} class="size-4" />
                {s.label}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Featured player -->
    <div class="reveal card mt-12 p-4 sm:p-6">
      <div class="mb-4 flex items-center justify-between gap-4">
        <p class="flex items-center gap-3">
          <Equalizer bars={5} height="16px" />
          <span class="label text-xs text-fg">Now playing — “{featured.title}”</span>
        </p>
        <span class="hidden font-mono text-xs text-muted sm:inline">Prod. Rhaffy</span>
      </div>
      <!-- Player loads only when scrolled near (keeps Spotify's scripts and cookies off the initial load). -->
      <div class="h-[152px] overflow-hidden rounded-xl bg-ink-2">
        <iframe
          id="spotify-player"
          title={`Spotify player: ${featured.title} by LOP3Z`}
          data-src={featured.spotifyEmbed}
          width="100%"
          height="152"
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
          class="block border-0"></iframe>
        <noscript>
          <iframe
            title={`Spotify player: ${featured.title} by LOP3Z`}
            src={featured.spotifyEmbed}
            width="100%"
            height="152"
            loading="lazy"
            class="block border-0"></iframe>
        </noscript>
      </div>
    </div>

    <!-- Singles grid -->
    <ul class="mt-8 grid grid-cols-2 gap-4 sm:gap-6 lg:grid-cols-4">
      {
        singles.map((single, i) => (
          <li class="reveal" style={`transition-delay:${i * 80}ms`}>
            <a
              href={single.spotify}
              target="_blank"
              rel="noopener"
              class="card group block h-full p-2.5 hover:-translate-y-1 sm:p-3"
            >
              <div class="relative aspect-square overflow-hidden bg-ink-2">
                {single.cover ? (
                  <Picture
                    src={single.cover}
                    formats={['avif', 'webp']}
                    widths={[240, 400, 600]}
                    sizes="(min-width: 1024px) 290px, (min-width: 640px) 45vw, 46vw"
                    alt={single.coverAlt ?? `${single.title} cover art`}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    pictureAttributes={{ class: 'block h-full w-full' }}
                  />
                ) : (
                  <div
                    class="flex h-full w-full flex-col justify-between bg-[radial-gradient(circle_at_30%_20%,rgb(255_182_39/0.35),transparent_55%),radial-gradient(circle_at_80%_90%,rgb(34_228_255/0.3),transparent_55%)] p-4"
                    role="img"
                    aria-label={`${single.title} — typographic artwork`}
                  >
                    <span class="font-mono text-[0.65rem] tracking-[0.2em] text-fg/80 uppercase">LOP3Z</span>
                    <span class="font-display text-4xl leading-none font-extrabold sm:text-5xl">
                      <span class="name-gradient">{single.title}</span>
                    </span>
                    <Equalizer bars={7} height="22px" width="4px" />
                  </div>
                )}
                <span
                  class="absolute right-2.5 bottom-2.5 grid size-11 translate-y-2 place-items-center rounded-full bg-cyan text-ink opacity-0 shadow-lg transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100"
                  aria-hidden="true"
                >
                  <svg viewBox="0 0 24 24" class="ml-0.5 size-5" fill="currentColor">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </div>
              <div class="flex items-start justify-between gap-2 px-1 pt-3 pb-1">
                <div class="min-w-0">
                  <h3 class="truncate text-lg font-bold sm:text-xl">{single.title}</h3>
                  {single.subtitle && <p class="truncate font-mono text-xs text-muted">{single.subtitle}</p>}
                </div>
                <Icon name="spotify" class="mt-1 size-4 shrink-0 text-muted transition-colors group-hover:text-[#1ED760]" />
              </div>
              <span class="sr-only">— listen on Spotify (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  const player = document.getElementById('spotify-player') as HTMLIFrameElement | null;
  if (player?.dataset.src) {
    const load = () => {
      player.src = player.dataset.src!;
      player.removeAttribute('data-src');
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: '300px 0px' },
      );
      io.observe(player);
    } else {
      load();
    }
  }
</script>
