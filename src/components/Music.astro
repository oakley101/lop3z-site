---
import { Picture } from 'astro:assets';
import { singles, spotifyId, streaming, upcoming } from '../data/site';
import Equalizer from './Equalizer.astro';
import Icon from './Icon.astro';

const embed = (url: string) => `https://open.spotify.com/embed/track/${spotifyId(url)}?utm_source=generator&theme=0`;
const first = singles[0];
---

<section id="music" aria-labelledby="music-title" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="reveal flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="section-kicker">01 // Music</p>
        <h2 id="music-title" class="mt-3 text-5xl font-extrabold tracking-tight sm:text-7xl">Press play.</h2>
      </div>
      <ul class="flex flex-wrap gap-3" aria-label="Follow LOP3Z on streaming platforms">
        {
          streaming.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" class="btn btn-ghost !min-h-11 !px-4 !text-xs">
                <Icon name={s.icon} class="size-4" />
                {s.label}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-[7fr_5fr] lg:gap-8">
      <!-- Player -->
      <div class="reveal card p-3 sm:p-4">
        <div class="mb-3 flex items-center justify-between gap-4 px-1">
          <p class="flex items-center gap-3">
            <Equalizer bars={5} height="16px" />
            <span class="label text-xs text-fg">Now playing — “<span id="now-playing">{first.title}</span>”</span>
          </p>
          <span class="hidden font-mono text-xs text-muted sm:inline">Spotify</span>
        </div>
        <!-- Player loads only when scrolled near (keeps Spotify's scripts and cookies off the initial load). -->
        <div class="h-[352px] overflow-hidden rounded-xl bg-ink-2">
          <iframe
            id="spotify-player"
            title={`Spotify player: ${first.title} by LOP3Z`}
            data-src={embed(first.spotify)}
            width="100%"
            height="352"
            loading="lazy"
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
            class="block border-0"></iframe>
          <noscript>
            <iframe
              title={`Spotify player: ${first.title} by LOP3Z`}
              src={embed(first.spotify)}
              width="100%"
              height="352"
              loading="lazy"
              class="block border-0"></iframe>
          </noscript>
        </div>
      </div>

      <!-- Tracklist -->
      <div class="reveal">
        <p class="label mb-3 text-[0.68rem] text-muted">Pick a track</p>
        <ol class="divide-y divide-line border-y border-line">
          <li>
            <a href="#skelewu" class="track group" data-upcoming>
              <span class="track-num text-gold">00</span>
              <Picture
                src={upcoming.cover}
                formats={['avif', 'webp']}
                widths={[64, 128]}
                sizes="56px"
                alt=""
                loading="lazy"
                class="size-14 object-cover"
                pictureAttributes={{ class: 'block size-14 shrink-0 overflow-hidden' }}
              />
              <span class="min-w-0 flex-1">
                <span class="block truncate text-lg font-bold">{upcoming.title}</span>
                <span class="block truncate font-mono text-xs text-gold">
                  <span data-before-release>Coming 23.10.26</span><span data-after-release>New single · Out now</span>
                </span>
              </span>
              <span class="label shrink-0 border border-gold/50 px-2 py-1 text-[0.6rem] text-gold" data-before-release>Soon</span>
              <span class="label shrink-0 border border-gold/50 px-2 py-1 text-[0.6rem] text-gold" data-after-release>New</span>
            </a>
          </li>
          {
            singles.map((single, i) => (
              <li>
                <a
                  href={single.spotify}
                  target="_blank"
                  rel="noopener"
                  class="track group"
                  data-embed={embed(single.spotify)}
                  data-title={single.title}
                  aria-current={i === 0 ? 'true' : undefined}
                >
                  <span class="track-num">{String(i + 1).padStart(2, '0')}</span>
                  {single.cover && (
                    <Picture
                      src={single.cover}
                      formats={['avif', 'webp']}
                      widths={[64, 128]}
                      sizes="56px"
                      alt=""
                      loading="lazy"
                      class="size-14 object-cover"
                      pictureAttributes={{ class: 'block size-14 shrink-0 overflow-hidden' }}
                    />
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-lg font-bold">{single.title}</span>
                    {single.subtitle && <span class="block truncate font-mono text-xs text-muted">{single.subtitle}</span>}
                  </span>
                  <span class="track-play" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="ml-0.5 size-4" fill="currentColor">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                  <span class="sr-only">— play {single.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  const player = document.getElementById('spotify-player') as HTMLIFrameElement | null;
  const nowPlaying = document.getElementById('now-playing');

  if (player?.dataset.src) {
    const load = () => {
      if (!player.dataset.src) return;
      player.src = player.dataset.src;
      player.removeAttribute('data-src');
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: '300px 0px' },
      );
      io.observe(player);
    } else {
      load();
    }
  }

  // Tracklist rows swap the embedded player instead of leaving the site.
  const tracks = document.querySelectorAll<HTMLAnchorElement>('#music a[data-embed]');
  tracks.forEach((a) =>
    a.addEventListener('click', (e) => {
      if (!player || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      tracks.forEach((t) => t.removeAttribute('aria-current'));
      a.setAttribute('aria-current', 'true');
      player.removeAttribute('data-src');
      player.src = a.dataset.embed!;
      player.title = `Spotify player: ${a.dataset.title} by LOP3Z`;
      if (nowPlaying) nowPlaying.textContent = a.dataset.title!;
      if (window.matchMedia('(max-width: 1023px)').matches) {
        player.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }),
  );
</script>
