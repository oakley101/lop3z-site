---
import '@fontsource-variable/sora';
import '@fontsource/chakra-petch/500.css';
import '@fontsource/chakra-petch/600.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import soraLatin from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { artist, seo, streaming, socials, singles, contact } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = seo.title, description = seo.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(seo.ogImage, Astro.site).href;

const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN?.trim();
const plausibleSrc = import.meta.env.PUBLIC_PLAUSIBLE_SRC?.trim() || 'https://plausible.io/js/script.js';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': new URL('/#artist', Astro.site).href,
  name: artist.name,
  url: new URL('/', Astro.site).href,
  image: ogImage,
  description: artist.bio.join(' '),
  genre: artist.genre,
  sameAs: [...streaming, ...socials].map((p) => p.url),
  email: `mailto:${contact.email}`,
  telephone: contact.phone,
  track: singles.map((s) => ({
    '@type': 'MusicRecording',
    name: s.title,
    url: s.spotify,
    byArtist: { '@id': new URL('/#artist', Astro.site).href },
  })),
};
---

<!doctype html>
<html lang="en" class="bg-ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#05060a" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <link rel="preload" href={soraLatin} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:type" content="music.musician" />
    <meta property="og:site_name" content={artist.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:locale" content={seo.locale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={seo.twitterHandle} />
    <meta name="twitter:creator" content={seo.twitterHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={seo.ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>document.documentElement.classList.add('js');</script>

    {
      plausibleDomain && (
        <script is:inline defer data-domain={plausibleDomain} src={plausibleSrc} />
      )
    }
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <div class="backdrop" aria-hidden="true"></div>
    <slot />
  </body>
</html>
