# Copy to .env for local testing. On Netlify, set these under
# Site configuration → Environment variables instead.

# Canonical site URL (no trailing slash). Defaults to Netlify's URL.
# SITE_URL=https://lop3z.com

# Plausible analytics — set to the domain you registered in Plausible.
# Leave unset/empty to disable analytics completely (no script is output).
# PUBLIC_PLAUSIBLE_DOMAIN=lop3z.com

# Optional: self-hosted or proxied Plausible script.
# PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
